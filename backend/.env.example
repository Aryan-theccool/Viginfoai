# Copy to .env and adjust. The app runs fully offline with defaults.
# DATABASE_URL=postgresql+psycopg2://viginfo:viginfo@localhost:5432/viginfo
DATABASE_URL=sqlite:///./viginfo.db

# Optional — when set, the AI engine uses OpenAI structured outputs.
# Without it, the built-in explainable heuristic engine is used (great for demos).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# CORS for the React dev server
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seed demo data on first startup (set to false in production)
AUTO_SEED=true
